# ==============================================================================
# Recoverix - Environment Configuration Example
# Copy this file to .env before starting containers:
#   cp .env.example .env
# ==============================================================================

# Backend: Google Gemini API Key for AI evidence interpretation (optional).
# If omitted or left blank, Recoverix runs in offline mode using deterministic rules.
GEMINI_API_KEY=

# Backend: Force offline mode (0 = online if key provided, 1 = force deterministic rules)
RECOVERIX_OFFLINE=0

# Frontend: Backend API URL accessible from the investigator's web browser
NEXT_PUBLIC_API_URL=http://localhost:8000
